{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/deepcoder:1.5b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "deepcoder:1.5b": {
          "name": "deepcoder 1.5b",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  }
}